{
  "name": "master-paging-in-os",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "install-all": "npm install --workspaces",
    "build": "cd server && npm run build",
    "start": "cd server && npm start",
    "start:client": "npm --workspace client run dev",
    "start:server": "npm --workspace server run start"
  }
}
